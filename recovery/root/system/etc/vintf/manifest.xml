<!--
    Input:
        system/libhidl/vintfdata/manifest.xml
-->
<manifest version="4.0" type="framework">
    <!-- Display Service HAL -->
    <hal format="hidl" max-level="6">
        <name>android.frameworks.displayservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IDisplayService/default</fqname>
    </hal>

    <!-- Scheduler Service HAL -->
    <hal format="hidl" max-level="5">
        <name>android.frameworks.schedulerservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISchedulingPolicyService/default</fqname>
    </hal>

    <!-- Sensor Service HAL -->
    <hal format="aidl">
        <name>android.frameworks.sensorservice</name>
        <fqname>ISensorManager/default</fqname>
    </hal>
    <hal format="hidl" max-level="8">
        <name>android.frameworks.sensorservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISensorManager/default</fqname>
    </hal>

    <!-- Memory HAL -->
    <hal format="hidl" max-level="8">
        <name>android.hidl.memory</name>
        <transport arch="32+64">passthrough</transport>
        <fqname>@1.0::IMapper/ashmem</fqname>
    </hal>

    <!-- Net HAL -->
    <hal format="hidl" max-level="7">
        <name>android.system.net.netd</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::INetd/default</fqname>
    </hal>

    <!-- WiFi Keystore HAL -->
    <hal format="hidl" max-level="7">
        <name>android.system.wifi.keystore</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IKeystore/default</fqname>
    </hal>

    <!-- Netutils Wrapper -->
    <hal format="native">
        <name>netutils-wrapper</name>
        <version>1.0</version>
    </hal>

    <!-- System SDK versions -->
    <system-sdk>
        <version>29</version>
        <version>30</version>
        <version>31</version>
        <version>32</version>
        <version>33</version>
        <version>34</version>
        <version>35</version>
    </system-sdk>

    <!-- Health HALs (System) -->
    <!-- HIDL Health @2.1 -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <fqname>@2.1::IHealth/default</fqname>
    </hal>

    <!-- AIDL Health v2 -->
    <hal format="aidl">
        <name>android.hardware.health</name>
        <version>2</version>
        <fqname>IHealth/default</fqname>
    </hal>
</manifest>
